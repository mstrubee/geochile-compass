# Variables de entorno de GeoChile Compass.
# Copia este archivo a `.env` y completa los valores. `.env` está en .gitignore.
# Solo las variables con prefijo VITE_ llegan al navegador: no pongas secretos en ellas.

# ── Supabase (obligatorias) ──────────────────────────────────────────────────
# Dashboard de Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Manzanas API — leave empty to use the bundled MockManzanaService.
# Point to a PostGIS-backed REST endpoint to switch to real INE Censo 2017 data.
VITE_MANZANA_API_URL=

# Google Maps Platform API Key
# Habilita: Map Tiles API (2D tiles), Geocoding API, Places Autocomplete.
# Restricción recomendada: HTTP referrers → tu dominio + localhost.
# Obtener en: https://console.cloud.google.com/apis/credentials
# Dejar vacío para usar solo OpenStreetMap (sin costo).
VITE_GOOGLE_MAPS_KEY=

# Overpass API (OSM) — override only if you run your own instance
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# ── Scripts de sincronización (NO van en .env) ───────────────────────────────
# `scripts/sync-ventas.sh` lee `.env.sync` (también en .gitignore) con:
#   SUPABASE_URL=
#   SUPABASE_SERVICE_ROLE_KEY=   # service role: nunca en el navegador ni en el repo
# Ver docs/sync-ventas-local.md y docs/sync-ventas-drive.md.
